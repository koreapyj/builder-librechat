+describe('fetchModels with provider anthropic (custom endpoint)', () => {
+  beforeEach(() => {
+    mockedAxios.get.mockReset().mockResolvedValue({
+      data: { data: [{ id: 'claude-a' }, { id: 'claude-b' }] },
+    });
+    (logger.error as jest.Mock).mockClear();
+  });
+
+  it('requests <base>/v1/models?limit=1000 with Anthropic headers', async () => {
+    const models = await fetchModels({
+      apiKey: 'ant-key',
+      baseURL: 'https://gw.example.com/anthropic/',
+      name: 'GatewayAnt',
+      provider: 'anthropic',
+    });
+
+    expect(models).toEqual(['claude-a', 'claude-b']);
+    expect(mockedAxios.get).toHaveBeenCalledWith(
+      'https://gw.example.com/anthropic/v1/models?limit=1000',
+      expect.objectContaining({
+        headers: expect.objectContaining({
+          'x-api-key': 'ant-key',
+          'anthropic-version': expect.any(String),
+        }),
+      }),
+    );
+    const headers = mockedAxios.get.mock.calls[0][1]?.headers as Record<string, string>;
+    expect(headers.Authorization).toBeUndefined();
+  });
+
+  it('does not double /v1 when baseURL already ends with it', async () => {
+    await fetchModels({
+      apiKey: 'ant-key',
+      baseURL: 'https://gw.example.com/anthropic/v1',
+      name: 'GatewayAnt',
+      provider: 'anthropic',
+    });
+
+    expect(mockedAxios.get).toHaveBeenCalledWith(
+      'https://gw.example.com/anthropic/v1/models?limit=1000',
+      expect.any(Object),
+    );
+  });
+
+  it('keeps userIdQuery alongside limit', async () => {
+    await fetchModels({
+      user: 'user123',
+      apiKey: 'ant-key',
+      baseURL: 'https://gw.example.com/anthropic',
+      name: 'GatewayAnt',
+      provider: 'anthropic',
+      userIdQuery: true,
+    });
+
+    expect(mockedAxios.get).toHaveBeenCalledWith(
