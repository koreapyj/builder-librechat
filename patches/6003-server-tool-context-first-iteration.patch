+/**
+ * builder-librechat: context-size details of a model call that ran provider
+ * server tools, read from its final message's `response_metadata.usage`.
+ * Returns `{}` (nothing to add to the usage event) when no server tool request
+ * was reported. Context display only; billing keeps the provider's summed usage.
+ *
+ * A streamed Anthropic call keeps the first iteration's `message_start` usage
+ * there (without `output_tokens`); a non-streamed call keeps the provider's
+ * final usage, whose `output_tokens` marks the input as the iteration sum, so
+ * no first-iteration input is reported for it.
+ */
+export const getServerToolContextUsage = (
+  output: unknown,
+): Pick<TTokenUsageEvent, 'server_tool_requests' | 'first_iteration_input'> => {
+  const usage = (output as { response_metadata?: { usage?: unknown } } | null | undefined)
+    ?.response_metadata?.usage;
+  if (usage == null || typeof usage !== 'object') {
+    return {};
+  }
+  const raw = usage as Record<string, unknown>;
+  const serverToolUse = raw.server_tool_use;
+  if (serverToolUse == null || typeof serverToolUse !== 'object') {
+    return {};
+  }
+  let requests = 0;
+  for (const [key, value] of Object.entries(serverToolUse)) {
+    if (key.endsWith('_requests') && typeof value === 'number' && Number.isFinite(value)) {
+      requests += value;
+    }
+  }
+  if (!(requests > 0)) {
+    return {};
+  }
+  const result: Pick<TTokenUsageEvent, 'server_tool_requests' | 'first_iteration_input'> = {
+    server_tool_requests: requests,
+  };
+  const inputTokens = finiteNonNegativeInteger(raw.input_tokens);
+  if (inputTokens != null && raw.output_tokens == null) {
+    const cacheCreation = finiteNonNegativeInteger(raw.cache_creation_input_tokens) ?? 0;
+    const cacheRead = finiteNonNegativeInteger(raw.cache_read_input_tokens) ?? 0;
+    result.first_iteration_input = {
+      prompt_tokens: Math.min(Number.MAX_SAFE_INTEGER, inputTokens + cacheCreation + cacheRead),
+      cache_creation: cacheCreation,
+      cache_read: cacheRead,
+    };
+  }
+  return result;
+};
