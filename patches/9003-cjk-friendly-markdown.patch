+import remarkGfm from 'remark-gfm';
+import { gfm } from 'micromark-extension-gfm';
+import { cjkFriendlyExtension } from 'micromark-extension-cjk-friendly';
+import { gfmStrikethroughCjkFriendly } from 'micromark-extension-cjk-friendly-gfm-strikethrough';
+import type { Extension as MicromarkExtension } from 'micromark-util-types';
+import type { PluggableList, Plugin } from 'unified';
+import type { Root } from 'mdast';
+
+interface ParserData {
+  micromarkExtensions?: MicromarkExtension[];
+}
+
+/**
+ * CJK-friendly emphasis: lets `**…(괄호)**이` close before a Korean particle, which the
+ * CommonMark flanking rules reject when the closer follows punctuation. Same parse-only
+ * registration as `remark-cjk-friendly/parseOnly`, without its `unified@11` peer, which
+ * would install a second unified/unist type tree under the client workspace.
+ */
+const remarkCjkFriendly: Plugin<[], Root> = function remarkCjkFriendly() {
+  const data = this.data() as ParserData;
+  (data.micromarkExtensions ??= []).push(cjkFriendlyExtension());
+};
+
+/** CJK-friendly `~~` strikethrough; see {@link remarkCjkFriendly} for why it is local. */
+const remarkCjkFriendlyGfmStrikethrough: Plugin<[], Root> =
+  function remarkCjkFriendlyGfmStrikethrough() {
+    const data = this.data() as ParserData;
+    (data.micromarkExtensions ??= []).push(gfmStrikethroughCjkFriendly({ singleTilde: false }));
+  };
+
+/**
+ * GFM with only the spec's `~~` strikethrough, plus CJK-friendly emphasis and strikethrough.
+ *
+ * `singleTilde: false` everywhere: a lone `~` is a range (`10~20명`) or "approximately"
+ * (`~50%`) in model output, never strikethrough. The CJK strikethrough extension registers
+ * its own strikethrough construct, so it needs the same option or single-tilde ranges
+ * come back.
+ *
+ * Subscript/superscript syntax (`~x~`, `^x^`) is intentionally not supported; math
+ * (`$H_2O$`, `$x^2$`) covers it.
+ */
+export const gfmRemarkPlugins: PluggableList = [
+  [remarkGfm, { singleTilde: false }],
+  remarkCjkFriendly,
+  remarkCjkFriendlyGfmStrikethrough,
+];
+
+/** The micromark extensions behind `gfmRemarkPlugins`, in the same order, for `fromMarkdown`. */
+export const gfmMicromarkExtensions = (): MicromarkExtension[] => [
+  gfm({ singleTilde: false }),
+  cjkFriendlyExtension(),
+  gfmStrikethroughCjkFriendly({ singleTilde: false }),
+];
